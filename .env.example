# KREDENSIAL SUPABASE UNTUK PROYEK E-PROCUREMENT RIFANSI
# Dapatkan nilai ini dari Dashboard Supabase: Project Settings -> API
# 
# Untuk pengujian lokal:
# Salin isi file ini ke file baru bernama `.env.local`
#
# Untuk Production (Vercel):
# Masukkan 2 variabel ini di Vercel Dashboard:
# Project Settings -> Environment Variables

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
